# TEMPLATE ONLY: DO NOT COMMIT REAL PASSWORDS TO GIT
# This template demonstrates the structure of the Secret synchronized from Azure Key Vault.
# To create manually for offline testing:
# oc create secret generic app-secrets \
#   --from-literal=APP_SECURITY_USER="api-user" \
#   --from-literal=APP_SECURITY_PASSWORD="<YOUR_SECRET_VALUE>" \
#   -n payment-app
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: payment-app
  labels:
    app.kubernetes.io/part-of: banking-platform
type: Opaque
stringData:
  APP_SECURITY_USER: "api-user"
  APP_SECURITY_PASSWORD: "<SET_PASSWORD_IN_AZURE_KEY_VAULT>"
  KAFKA_SSL_TRUSTSTORE_PASSWORD: "<SET_PASSWORD_IN_AZURE_KEY_VAULT>"
  LOGGING_TRUSTSTORE_PASSWORD: "<SET_PASSWORD_IN_AZURE_KEY_VAULT>"
